[Unit]
Description=groxy — снимок состояния раз в минуту

[Timer]
# Отсчёт от завершения прошлого запуска, а не от начала: если снимок однажды
# затянется дольше минуты, OnUnitActiveSec выстроил бы очередь запусков друг на
# друге, каждый со своей блокировкой.
OnBootSec=2min
OnUnitInactiveSec=1min

# Без выравнивания по границам: тридцать шесть клиентов и один узел, разброс
# ничему не мешает, а точное совпадение с минутой сталкивало бы снимок с
# ежеминутными задачами системы.
AccuracySec=10s
Persistent=false

[Install]
WantedBy=timers.target
