[Unit]
Description=groxy — проверять раз в пять минут, жив ли бот на бридже

[Timer]
# Порог молчания — пятнадцать минут, проверка раз в пять: между «бот замолчал»
# и сообщением проходит не больше двадцати. Чаще проверять нечего, реже —
# значит узнавать о поломке заметно позже жалобы, ради чего всё и затевалось.
OnBootSec=5min
OnUnitInactiveSec=5min
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
