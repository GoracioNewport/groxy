[Unit]
Description=groxy — снимок состояния бриджа в sqlite
# Снимок без wg0 бессмысленен, но и ждать его не надо: таймер повторится через
# минуту, а Requires= уронил бы юнит при каждой правке интерфейса.
After=wg-quick@wg0.service

[Service]
Type=oneshot
User=groxy-bot
Group=groxy-bot
ExecStart=/opt/groxy/bot/bin/groxy-snapshot

# Снимок читает /proc, зовёт groxy через sudo и пишет в свою базу. Больше
# ничего ему не нужно.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/groxy-bot

# Здесь нет ProtectKernelTunables, ProtectControlGroups, RestrictSUIDSGID,
# RestrictRealtime и LockPersonality, хотя напрашиваются. Каждая из них
# **неявно** включает NoNewPrivileges, а он запрещает sudo повышать права:
# systemd отвечает «the no new privileges flag is set, which prevents sudo
# from running as root», и снимок не снимается вовсе. Явное
# NoNewPrivileges=no их не переспоривает — проверено на боевом бридже 07.09.
#
# Так что выбор был не между «защищённо» и «нет», а между защитой файловой
# системы и правом позвать CLI. Оставлено то, что не конфликтует: корень
# только на чтение, чужие домашние каталоги скрыты, /tmp свой, писать можно
# ровно в свой каталог с базой.
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
