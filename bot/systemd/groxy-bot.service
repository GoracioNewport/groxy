[Unit]
Description=groxy — Telegram-бот управления профилями
# Telegram достижим только через туннель до портала: прямой путь закрыт
# фильтром провайдера. Ждать интерфейс не обязательно — бот переживает
# сетевые обрывы с нарастающей паузой, — но стартовать после него разумнее.
After=network-online.target wg-quick@wg1.service
Wants=network-online.target

[Service]
Type=simple
User=groxy-bot
Group=groxy-bot
ExecStart=/opt/groxy/bot/bin/groxy-bot
Restart=always
RestartSec=10s

# Код возврата 3 означает «Telegram не принял токен». Перезапускать в этом
# случае бессмысленно: через десять секунд токен не станет годным, а журнал
# заполнится одинаковыми строками, среди которых потеряется настоящая причина.
RestartPreventExitStatus=3

# Про отсутствующие ProtectKernelTunables и соседей — см. groxy-snapshot.service:
# каждая из них неявно включает NoNewPrivileges, а он запрещает sudo повышать
# права, без которых бот не может позвать CLI.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=no

# Песочница юнита наследуется вызванным через sudo процессом: sudo меняет
# пользователя, но не пространство имён. Поэтому CLI, запущенный ботом от
# root, видит ту же файловую систему только для чтения — и всё, что он
# пишет, надо перечислить здесь.
#
# Без этого работали только `stats` и `list-*`, потому что они ничего не
# пишут и не берут блокировку. Любая изменяющая команда умирала с кодом 1 на
# `exec 9>/run/groxy.lock` — ещё до первой записи, так что состояние
# оставалось целым, а причина в журнал не попадала. Автопереключение при
# первой же боевой проверке 07.09 честно решило переключиться и не смогло.
#
# Проверять такое надо изнутри юнита: ручной запуск через `su` идёт мимо
# песочницы и проходит всегда.
ReadWritePaths=/var/lib/groxy-bot /etc/groxy /etc/wireguard /run

[Install]
WantedBy=multi-user.target
