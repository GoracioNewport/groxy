[Unit]
Description=groxy — ежедневный архив состояния

[Timer]
# Ночью по местному времени: снимок берёт общую блокировку, и столкнуться с
# выпуском профиля в три часа ночи куда менее вероятно, чем днём.
OnCalendar=*-*-* 03:40:00
# Пропущенный из-за выключенного узла запуск наверстать надо: бэкап, которого
# нет за позавчера, — это ровно тот бэкап, которого хватятся.
Persistent=true
RandomizedDelaySec=20min

[Install]
WantedBy=timers.target
