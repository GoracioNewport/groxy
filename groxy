#!/usr/bin/env bash
#
# groxy — двухуровневый WireGuard с whitelist-маршрутизацией.
#
# Bridge (RU VPS) принимает клиентов через wg0, маркирует трафик iptables'ом и
# заворачивает в wg1 → portal (foreign VPS) всё, кроме доменов из ipset
# vpn_domains. Так российские сервисы видят российский IP, остальное идёт
# через portal.
#
# Этот файл — диспетчер подкоманд. Реальная логика живёт в lib/.

set -euo pipefail

readonly GROXY_VERSION='0.1.0-dev'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly LIB_DIR="${SCRIPT_DIR}/lib"

# shellcheck source=lib/common.sh
source "${LIB_DIR}/common.sh"
# shellcheck source=lib/system.sh
source "${LIB_DIR}/system.sh"
# shellcheck source=lib/wireguard.sh
source "${LIB_DIR}/wireguard.sh"
# shellcheck source=lib/portal.sh
source "${LIB_DIR}/portal.sh"
# shellcheck source=lib/bridge.sh
source "${LIB_DIR}/bridge.sh"
# shellcheck source=lib/bridge_wg0.sh
source "${LIB_DIR}/bridge_wg0.sh"
# shellcheck source=lib/bridge_ipset.sh
source "${LIB_DIR}/bridge_ipset.sh"
# shellcheck source=lib/bridge_dns.sh
source "${LIB_DIR}/bridge_dns.sh"
# shellcheck source=lib/bridge_geoip.sh
source "${LIB_DIR}/bridge_geoip.sh"
# shellcheck source=lib/bridge_settings.sh
source "${LIB_DIR}/bridge_settings.sh"
# shellcheck source=lib/bridge_portals.sh
source "${LIB_DIR}/bridge_portals.sh"
# shellcheck source=lib/status.sh
source "${LIB_DIR}/status.sh"

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
    cat <<'EOF'
groxy — двухуровневый WireGuard с whitelist-маршрутизацией.

Usage: groxy <command> [args...]

Commands:
  init <portal|bridge> [flags]   Первичная установка роли.
  apply                          Перегенерировать конфиги из /etc/groxy/.
  status                         Показать роль, сервисы, peer'ы.
  uninstall [--yes]              Снести установку (бэкап в /etc/groxy.bak.<ts>).

  portal <subcommand>            Управление peer'ами portal'а.
  bridge <subcommand>            Управление peer'ами, клиентами, whitelist'ом bridge'а.

  version                        Показать версию.
  help                           Показать эту справку.

Запустите 'groxy portal' или 'groxy bridge' без аргументов,
чтобы увидеть список их подкоманд.
EOF
}

usage_portal() {
    cat <<'EOF'
Usage: groxy portal <subcommand> [args...]

Subcommands:
  add-bridge <bridge-name>                          Создать peer и напечатать portal profile.
  accept-bridge <bridge-name> --pubkey=<key>        Активировать peer по pubkey'ю bridge'а.
  remove-bridge <bridge-name> [--yes]               Удалить peer.
  list-bridges                                      Показать зарегистрированные bridge'и.
EOF
}

usage_bridge() {
    cat <<'EOF'
Usage: groxy bridge <subcommand> [args...]

Subcommands:
  add-portal <portal-name> --profile=<file>         Импортировать portal profile.
  use-portal <portal-name>                          Переключить активный portal.
  list-portals                                      Показать доступные portal'ы.
  remove-portal <portal-name> [--yes]               Удалить portal profile.

  add-client <client-name> [--qr]                   Создать WG-клиента, напечатать конфиг (+ QR в stderr).
  remove-client <client-name> [--yes]               Удалить клиента.
  list-clients                                      Показать клиентов.

  whitelist <update|reload|set-source>              Управление whitelist'ом доменов.
  geoip <update|set-source>                         Управление GeoIP-карв-аутом (ipset ru_cidrs).
  settings <get|set>                                3 тоггла feed'ов whitelist'a.
EOF
}

usage_bridge_settings() {
    cat <<'EOF'
Usage: groxy bridge settings <subcommand> [args...]

Subcommands:
  get                            Показать все 3 тоггла.
  set <key> <on|off>             Включить/выключить feed.
                                 Keys: opencck (DNS cron-feed),
                                       custom  (DNS из custom.txt),
                                       geoip   (RU CIDR через ru_cidrs ipset).
EOF
}

usage_bridge_geoip() {
    cat <<'EOF'
Usage: groxy bridge geoip <subcommand> [args...]

Subcommands:
  update                Скачать свежий CIDR-список и перенаполнить ipset ru_cidrs.
  set-source <url>      Сменить URL источника CIDR-списка (default — github.com/herrbischoff/country-ip-blocks).
EOF
}

usage_bridge_whitelist() {
    cat <<'EOF'
Usage: groxy bridge whitelist <subcommand> [args...]

Subcommands:
  update                Скачать свежий opencck-список и перезапустить dnsmasq.
  reload                Перечитать custom.txt / custom-ips.txt.
  set-source <url>      Сменить URL источника opencck.
EOF
}

version() {
    printf 'groxy %s\n' "${GROXY_VERSION}"
}

# ---------------------------------------------------------------------------
# Stub helper
# ---------------------------------------------------------------------------

# Каждая ещё-не-реализованная подкоманда вызывает stub. Печатает в stderr
# имя вызвавшей функции и аргументы — чтобы видеть, что dispatcher отработал.
stub() {
    log "stub: ${FUNCNAME[1]}($*)"
}

# ---------------------------------------------------------------------------
# Top-level commands
# ---------------------------------------------------------------------------

cmd_init() {
    local role="${1:-}"
    case "${role}" in
        portal)
            shift
            portal_init "$@"
            ;;
        bridge)
            shift
            bridge_init "$@"
            ;;
        ''|-h|--help|help)
            printf 'Usage: groxy init <portal|bridge> [flags]\n' >&2
            [[ -z "${role}" ]] && exit 2 || exit 0
            ;;
        *)
            die "unknown role: ${role} (expected: portal|bridge)"
            ;;
    esac
}

cmd_apply() {
    local role=''
    [[ -f "${GROXY_DIR}/role" ]] && role=$(<"${GROXY_DIR}/role")
    case "${role}" in
        portal) portal_apply ;;
        bridge) bridge_apply ;;
        '')     die "groxy not initialised on this host (run 'groxy init <portal|bridge>')" ;;
        *)      die "unknown role '${role}' in ${GROXY_DIR}/role" ;;
    esac
}

cmd_status() {
    cmd_status_real "$@"
}

cmd_uninstall() {
    stub "$@"
}

# ---------------------------------------------------------------------------
# Portal subcommands
# ---------------------------------------------------------------------------

cmd_portal() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        add-bridge)      portal_add_bridge "$@" ;;
        accept-bridge)   portal_accept_bridge "$@" ;;
        remove-bridge)   portal_remove_bridge "$@" ;;
        list-bridges)    portal_list_bridges "$@" ;;
        ''|-h|--help|help)
            usage_portal
            [[ -z "${sub}" ]] && exit 2 || exit 0
            ;;
        *)
            die "unknown portal subcommand: ${sub}"
            ;;
    esac
}

# portal_add_bridge / accept_bridge / remove_bridge / list_bridges defined in lib/portal.sh

# ---------------------------------------------------------------------------
# Bridge subcommands
# ---------------------------------------------------------------------------

cmd_bridge() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        add-portal)      bridge_add_portal "$@" ;;
        use-portal)      bridge_use_portal "$@" ;;
        list-portals)    bridge_list_portals "$@" ;;
        remove-portal)   bridge_remove_portal "$@" ;;
        add-client)      bridge_add_client "$@" ;;
        remove-client)   bridge_remove_client "$@" ;;
        list-clients)    bridge_list_clients "$@" ;;
        whitelist)       cmd_bridge_whitelist "$@" ;;
        geoip)           cmd_bridge_geoip "$@" ;;
        settings)        cmd_bridge_settings "$@" ;;
        ''|-h|--help|help)
            usage_bridge
            [[ -z "${sub}" ]] && exit 2 || exit 0
            ;;
        *)
            die "unknown bridge subcommand: ${sub}"
            ;;
    esac
}

# bridge_add_portal / use_portal / list_portals / remove_portal defined in lib/bridge_portals.sh
# bridge_add_client / list_clients / remove_client defined in lib/bridge_wg0.sh

cmd_bridge_whitelist() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        update)       bridge_whitelist_update "$@" ;;
        reload)       bridge_whitelist_reload "$@" ;;
        set-source)   bridge_whitelist_set_source "$@" ;;
        ''|-h|--help|help)
            usage_bridge_whitelist
            [[ -z "${sub}" ]] && exit 2 || exit 0
            ;;
        *)
            die "unknown whitelist subcommand: ${sub}"
            ;;
    esac
}

# bridge_whitelist_update / reload / set_source defined in lib/bridge_dns.sh

cmd_bridge_settings() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        get)         bridge_settings_get "$@" ;;
        set)         bridge_settings_set "$@" ;;
        ''|-h|--help|help)
            usage_bridge_settings
            [[ -z "${sub}" ]] && exit 2 || exit 0
            ;;
        *)
            die "unknown settings subcommand: ${sub}"
            ;;
    esac
}

cmd_bridge_geoip() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        update)        bridge_geoip_update "$@" ;;
        set-source)    bridge_geoip_set_source "$@" ;;
        ''|-h|--help|help)
            usage_bridge_geoip
            [[ -z "${sub}" ]] && exit 2 || exit 0
            ;;
        *)
            die "unknown geoip subcommand: ${sub}"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

main() {
    local cmd="${1:-}"
    shift || true
    case "${cmd}" in
        init)        cmd_init "$@" ;;
        apply)       cmd_apply "$@" ;;
        status)      cmd_status "$@" ;;
        uninstall)   cmd_uninstall "$@" ;;
        portal)      cmd_portal "$@" ;;
        bridge)      cmd_bridge "$@" ;;
        version|-v|--version)  version ;;
        ''|help|-h|--help)
            usage
            [[ -z "${cmd}" ]] && exit 2 || exit 0
            ;;
        *)
            die "unknown command: ${cmd} (try: groxy help)"
            ;;
    esac
}

main "$@"
